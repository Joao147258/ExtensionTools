{
  "name": "extension-tools",
  "version": "0.1.0",
  "description": "Extensão modular de produtividade local-first para navegadores",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:arch": "node scripts/architecture/boundary-linter.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "security:markdown": "node scripts/security/scan-markdown.mjs",
    "security:sensitive": "node scripts/security/scan-sensitive-files.mjs",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "security:references": "node scripts/security/scan-forbidden-references.mjs",
    "security:paths": "node scripts/security/scan-private-paths.mjs",
    "security:guard": "node scripts/security/publication-guard.mjs",
    "security:precommit": "node scripts/security/publication-guard.mjs staged",
    "security:prepush": "node scripts/security/publication-guard.mjs outgoing",
    "test:security": "vitest run tests/harness/security/"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.14.0",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
}
